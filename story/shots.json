[
 {
  "i": 0,
  "s": 0,
  "e": 0.87,
  "line": "In this world,"
 },
 {
  "i": 1,
  "s": 0.87,
  "e": 2.065,
  "line": "every time you laugh,"
 },
 {
  "i": 2,
  "s": 2.065,
  "e": 3.656,
  "line": "you glow one shade brighter."
 },
 {
  "i": 3,
  "s": 3.656,
  "e": 6.206,
  "line": "That's why funny kids light up whole hallways,"
 },
 {
  "i": 4,
  "s": 6.206,
  "e": 7.994,
  "line": "and serious people are so dim"
 },
 {
  "i": 5,
  "s": 7.994,
  "e": 8.893,
  "line": "you bump into them."
 },
 {
  "i": 6,
  "s": 8.893,
  "e": 9.99,
  "line": "I was pretty normal."
 },
 {
  "i": 7,
  "s": 9.99,
  "e": 11.206,
  "line": "But my best friend Ollie"
 },
 {
  "i": 8,
  "s": 11.206,
  "e": 12.777,
  "line": "was the dimmest kid alive."
 },
 {
  "i": 9,
  "s": 12.777,
  "e": 14.111,
  "line": "He'd never laughed once."
 },
 {
  "i": 10,
  "s": 14.111,
  "e": 15.643,
  "line": "Our teacher marked him absent"
 },
 {
  "i": 11,
  "s": 15.643,
  "e": 16.927,
  "line": "while he stood right there."
 },
 {
  "i": 12,
  "s": 16.927,
  "e": 17.817,
  "line": "Meanwhile, Jasper"
 },
 {
  "i": 13,
  "s": 17.817,
  "e": 19.882,
  "line": "was so bright, you needed sunglasses."
 },
 {
  "i": 14,
  "s": 19.882,
  "e": 22.105,
  "line": "At lunch, he sneezed milk out his nose."
 },
 {
  "i": 15,
  "s": 22.105,
  "e": 23.103,
  "line": "I laughed so hard"
 },
 {
  "i": 16,
  "s": 23.103,
  "e": 24.674,
  "line": "I glowed one shade brighter."
 },
 {
  "i": 17,
  "s": 24.674,
  "e": 25.761,
  "line": "So I had an idea."
 },
 {
  "i": 18,
  "s": 25.761,
  "e": 26.967,
  "line": "If I laughed at everything,"
 },
 {
  "i": 19,
  "s": 26.967,
  "e": 28.677,
  "line": "I'd be the brightest kid in school."
 },
 {
  "i": 20,
  "s": 28.677,
  "e": 29.368,
  "line": "I fake-laughed"
 },
 {
  "i": 21,
  "s": 29.368,
  "e": 30.801,
  "line": "at a math test. Nothing."
 },
 {
  "i": 22,
  "s": 30.801,
  "e": 31.71,
  "line": "Then our teacher sat"
 },
 {
  "i": 23,
  "s": 31.71,
  "e": 32.718,
  "line": "on a whoopee cushion."
 },
 {
  "i": 24,
  "s": 32.718,
  "e": 33.993,
  "line": "I laughed for real,"
 },
 {
  "i": 25,
  "s": 33.993,
  "e": 35.228,
  "line": "and lit up like a lamp."
 },
 {
  "i": 26,
  "s": 35.228,
  "e": 36.74,
  "line": "So I hung out with funny kids,"
 },
 {
  "i": 27,
  "s": 36.74,
  "e": 37.837,
  "line": "watched cat videos,"
 },
 {
  "i": 28,
  "s": 37.837,
  "e": 38.924,
  "line": "read joke books."
 },
 {
  "i": 29,
  "s": 38.924,
  "e": 41.365,
  "line": "By sunset, I was almost as bright as Jasper."
 },
 {
  "i": 30,
  "s": 41.365,
  "e": 42.491,
  "line": "But then I saw Ollie,"
 },
 {
  "i": 31,
  "s": 42.491,
  "e": 44.092,
  "line": "alone in a dark corner."
 },
 {
  "i": 32,
  "s": 44.092,
  "e": 45.011,
  "line": "I'd spent all day"
 },
 {
  "i": 33,
  "s": 45.011,
  "e": 46.533,
  "line": "ignoring my best friend."
 },
 {
  "i": 34,
  "s": 46.533,
  "e": 47.481,
  "line": "So I went over."
 },
 {
  "i": 35,
  "s": 47.481,
  "e": 49.151,
  "line": "Want to hear the worst joke ever?"
 },
 {
  "i": 36,
  "s": 49.151,
  "e": 50.732,
  "line": "Why did the cookie see a doctor?"
 },
 {
  "i": 37,
  "s": 50.732,
  "e": 51.711,
  "line": "It felt crumby."
 },
 {
  "i": 38,
  "s": 51.711,
  "e": 52.738,
  "line": "Ollie snorted."
 },
 {
  "i": 39,
  "s": 52.738,
  "e": 53.519,
  "line": "Then he laughed,"
 },
 {
  "i": 40,
  "s": 53.519,
  "e": 55.416,
  "line": "and for the first time, he glowed."
 },
 {
  "i": 41,
  "s": 55.416,
  "e": 57.561,
  "line": "He laughed until he was brighter than me."
 },
 {
  "i": 42,
  "s": 57.561,
  "e": 58.331,
  "line": "Next morning,"
 },
 {
  "i": 43,
  "s": 58.331,
  "e": 60.1,
  "line": "our teacher marked him present."
 },
 {
  "i": 44,
  "s": 60.1,
